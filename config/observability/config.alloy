discovery.docker "itz" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}

discovery.relabel "itz" {
  targets = discovery.docker.itz.targets

  // Exclude the development container and the logging stack itself.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "eap|keycloak|oracle"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

loki.source.docker "itz" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.itz.output
  refresh_interval = "5s"
  labels           = { environment = "development", log_source = "container" }
  forward_to       = [loki.process.application.receiver]
}

loki.process "application" {
  // Keep the original JSON, including escaped stacktraces, for query-time parsing.
  // Shell startup output and Oracle's plain text must also remain available.
  stage.match {
    selector = "{service_name=~\"eap|keycloak\"}"

    stage.json {
      expressions = { level = "level" }
      drop_malformed = false
    }

    stage.labels {
      values = { level = "" }
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.source.file "oracle_alert" {
  targets = [{
    __path__     = "/var/log/oracle/rdbms/*/*/trace/alert*.log",
    service_name = "oracle",
    project      = sys.env("COMPOSE_PROJECT_NAME"),
    environment  = "development",
    log_source   = "oracle_alert",
  }]
  file_match {
    enabled = true
    sync_period = "5s"
  }
  forward_to = [loki.process.oracle_alert.receiver]
}

loki.process "oracle_alert" {
  // Oracle 19c prefixes alert records with an ISO timestamp on a separate line.
  stage.multiline {
    firstline     = "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    max_wait_time = "3s"
    max_lines     = 256
  }
  forward_to = [loki.write.local.receiver]
}

loki.source.file "oracle_listener" {
  targets = [{
    __path__     = "/var/log/oracle/tnslsnr/*/*/trace/listener.log",
    service_name = "oracle",
    project      = sys.env("COMPOSE_PROJECT_NAME"),
    environment  = "development",
    log_source   = "oracle_listener",
  }]
  file_match {
    enabled = true
    sync_period = "5s"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
