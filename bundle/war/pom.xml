<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>de.itz</groupId>
    <artifactId>bundle</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>itz-webapp</artifactId>
  <packaging>war</packaging>
  <name>itz web application</name>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>itz-rest-adapter</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>itz-jpa-adapter</artifactId>
    </dependency>
  </dependencies>
  <build>
    <finalName>itz-rest</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <configuration>
          <!-- This module contains no bytecode; its dependencies are WAR packaging inputs. -->
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
