<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>de.itz</groupId>
    <artifactId>bundle</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>itz-ear</artifactId>
  <packaging>ear</packaging>
  <name>itz EAR</name>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>itz-webapp</artifactId>
      <type>war</type>
    </dependency>
  </dependencies>
  <build>
    <finalName>itz</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-ear-plugin</artifactId>
        <executions>
          <execution>
            <?m2e ignore?>
            <id>default-generate-application-xml</id>
          </execution>
        </executions>
        <configuration>
          <version>10</version>
          <generateApplicationXml>true</generateApplicationXml>
          <modules>
            <webModule>
              <groupId>${project.groupId}</groupId>
              <artifactId>itz-webapp</artifactId>
              <bundleFileName>itz-rest.war</bundleFileName>
              <contextRoot>/itz</contextRoot>
            </webModule>
          </modules>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>deploy-eap</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.wildfly.plugins</groupId>
            <artifactId>wildfly-maven-plugin</artifactId>
            <configuration>
              <id>local-eap</id>
              <hostname>${eap.host}</hostname>
              <port>${eap.port}</port>
              <filename>${project.build.finalName}.ear</filename>
              <force>true</force>
            </configuration>
            <executions>
              <execution>
                <id>deploy-to-local-eap</id>
                <phase>install</phase>
                <goals>
                  <goal>deploy</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <properties>
    <eap.host>eap</eap.host>
    <eap.port>9990</eap.port>
  </properties>
</project>
