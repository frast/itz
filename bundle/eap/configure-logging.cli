# Configure before the first runtime boot so startup messages use JSON too.
embed-server --std-out=echo --server-config=standalone.xml
/subsystem=logging/json-formatter=ITZ_JSON:add(pretty-print=false,exception-output-type=formatted)
/subsystem=logging/console-handler=CONSOLE:write-attribute(name=named-formatter,value=ITZ_JSON)
stop-embedded-server
